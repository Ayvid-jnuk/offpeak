# Copy to .env and adjust as needed. Nothing here is a real secret.

ENV=development

# Any SQLAlchemy-compatible URL works. Defaults to local Postgres for the
# hackathon; swap to sqlite:///./offpeak.db for a zero-setup local run.
DATABASE_URL=postgresql+psycopg2://postgres:offpeak_dev@localhost:5432/offpeak

JWT_SECRET=dev-secret-change-me-in-prod-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

PLATFORM_COMMISSION_RATE=0.10
LOYALTY_POINTS_PER_DOLLAR=1
LOYALTY_POINTS_PER_CREDIT=500
LOYALTY_CREDIT_VALUE_CENTS=1000

# Dev-mode OTP: no real SMS provider required. In production this would be
# swapped for Twilio (or similar) behind app/services/auth_service.py.
OTP_DEV_MODE=true
OTP_STATIC_CODE=123456

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
